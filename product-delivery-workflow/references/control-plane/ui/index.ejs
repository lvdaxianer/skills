<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= pageTitle %></title>
    <link rel="stylesheet" href="/assets/styles.css">
  </head>
  <body>
    <main class="shell">
      <header class="page-header">
        <div>
          <p class="eyebrow">PRODUCT DELIVERY WORKFLOW / CONTROL PLANE</p>
          <h1><%= pageTitle %></h1>
          <p class="subtitle">
            统一管理全局问题、项目归属与规则差异；文件事实优先，
            SQLite 只做可重建查询投影。
          </p>
        </div>
        <div class="header-actions">
          <span id="sync-status" class="badge sync"><%= initialSyncStatus %></span>
          <button id="refresh-button" class="button secondary" type="button">刷新目录</button>
        </div>
      </header>

      <section class="toolbar" aria-label="全局问题筛选">
        <label>项目
          <input id="project-filter" placeholder="PROJECT-A（可选）">
        </label>
        <label>归属
          <select id="scope-filter">
            <option value="">全部</option>
            <option value="unknown">待判断</option>
            <option value="project">项目</option>
            <option value="common">公共</option>
            <option value="hybrid">Hybrid</option>
          </select>
        </label>
        <label>生命周期
          <select id="lifecycle-filter">
            <option value="">全部</option>
            <option value="active">有效</option>
            <option value="excluded">已排除</option>
            <option value="deprecated">已归档</option>
          </select>
        </label>
        <span id="status-message" class="status" role="status"><%= initialStatus %></span>
      </section>

      <section class="workspace">
        <section class="panel problem-panel">
          <div class="section-heading">
            <div>
              <p class="section-kicker">GLOBAL PROBLEMS</p>
              <h2>全局问题目录</h2>
            </div>
            <span class="helper">所有写操作都会留下 operationId 和审计历史</span>
          </div>
          <form id="create-problem-form" class="create-form">
            <input name="projectId" required placeholder="来源项目 ID">
            <input name="title" required placeholder="问题标题">
            <input name="solution" placeholder="初步解决方案">
            <input name="operator" required placeholder="操作者">
            <input name="reason" required placeholder="录入原因">
            <button class="button primary" type="submit">新增问题</button>
          </form>
          <div id="global-problem-list" class="knowledge-list" aria-live="polite"><%- knowledgeCards %></div>
        </section>

        <aside class="side-column">
          <section id="project-rules-panel" class="panel">
            <div class="section-heading compact">
              <div><p class="section-kicker">EFFECTIVE RULES</p><h2>项目有效规则</h2></div>
            </div>
            <div class="inline-form">
              <input id="project-rules-select" placeholder="项目 ID">
              <button id="load-rules-button" class="button secondary" type="button">查看</button>
            </div>
            <p id="rules-status" class="helper" role="status">
              选择项目查看 project / hybrid / common 生效关系。
            </p>
            <div id="project-rules-list" class="rule-list" aria-live="polite"></div>
          </section>

          <section id="rules-diff-panel" class="panel">
            <div class="section-heading compact">
              <div><p class="section-kicker">RULE DIFFERENCE</p><h2>跨项目差异</h2></div>
            </div>
            <div class="inline-form diff-form">
              <input id="diff-project-a" placeholder="项目 A">
              <input id="diff-project-b" placeholder="项目 B">
              <button id="compare-rules-button" class="button secondary" type="button">比较</button>
            </div>
            <p id="diff-status" class="helper" role="status">至少选择两个项目。</p>
            <div id="rules-diff-list" class="rule-list" aria-live="polite"></div>
          </section>
        </aside>
      </section>
    </main>

    <template id="problem-card-template">
      <article class="knowledge-card">
        <div class="card-header">
          <div>
            <span class="badge scope-badge"></span>
            <h3 class="knowledge-title"></h3>
          </div>
          <span class="badge lifecycle-badge"></span>
        </div>
        <p class="knowledge-meta"></p>
        <form class="problem-form">
          <label>标题<input name="title" required></label>
          <label>归属
            <select name="scope">
              <option value="unknown">待判断</option>
              <option value="project">项目</option>
              <option value="common">公共候选</option>
              <option value="hybrid">Hybrid</option>
            </select>
          </label>
          <label>目标项目<input name="owningProjectId" placeholder="project / hybrid 时填写"></label>
          <label>严重级别
            <select name="severity">
              <option value="critical">critical</option><option value="high">high</option>
              <option value="medium">medium</option><option value="low">low</option><option value="info">info</option>
            </select>
          </label>
          <label class="wide">解决方案<textarea name="solution" rows="3"></textarea></label>
          <label>操作者<input name="operator" required placeholder="姓名或账号"></label>
          <label>原因<input name="reason" required placeholder="为什么修改"></label>
          <div class="actions wide">
            <button class="button primary save-button" type="submit">保存修改</button>
            <button class="button danger exclude-button" type="button">排除</button>
            <button class="button secondary restore-button" type="button">恢复</button>
            <button class="button secondary publish-button" type="button">发布公共规则</button>
          </div>
        </form>
      </article>
    </template>

    <script type="module" src="/assets/app.js"></script>
  </body>
</html>
