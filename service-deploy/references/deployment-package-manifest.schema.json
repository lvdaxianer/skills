{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/service-deploy/deployment-package-manifest.schema.json",
  "title": "Service deployment package manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_name",
    "package_version",
    "application_version",
    "build_time",
    "source_commit",
    "supported_modes",
    "supported_os",
    "architectures",
    "offline_supported",
    "required_privilege",
    "entrypoints",
    "mode_payloads",
    "persistence_resources",
    "preflight",
    "files"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "package_name": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "package_version": {
      "type": "string",
      "pattern": "^(?!latest$|final$|release$)[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}$"
    },
    "application_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "build_time": {
      "type": "string",
      "format": "date-time"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^(manual|[A-Fa-f0-9]{7,64})$"
    },
    "supported_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["vm", "docker", "kubernetes"]
      }
    },
    "supported_os": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["amd64", "arm64"]
      }
    },
    "offline_supported": {
      "type": "boolean"
    },
    "required_privilege": {
      "enum": ["root", "sudo", "operator", "kubernetes-namespace-admin"]
    },
    "default_service_root": {
      "type": "string",
      "pattern": "^/[^\\0]*$"
    },
    "ports": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/port"
      }
    },
    "preflight": {
      "$ref": "#/$defs/preflight"
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deploy", "service", "doctor", "rollback", "uninstall"],
      "properties": {
        "deploy": { "$ref": "#/$defs/relativeExecutable" },
        "service": { "$ref": "#/$defs/relativeExecutable" },
        "doctor": { "$ref": "#/$defs/relativeExecutable" },
        "rollback": { "$ref": "#/$defs/relativeExecutable" },
        "uninstall": { "$ref": "#/$defs/relativeExecutable" }
      }
    },
    "mode_payloads": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vm": { "$ref": "#/$defs/modePayload" },
        "docker": { "$ref": "#/$defs/modePayload" },
        "kubernetes": { "$ref": "#/$defs/modePayload" }
      }
    },
    "persistence_resources": {
      "type": "array",
      "minItems": 6,
      "items": {
        "$ref": "#/$defs/persistenceCatalogItem"
      }
    },
    "unsupported_modes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "vm": { "type": "string", "minLength": 1 },
        "docker": { "type": "string", "minLength": 1 },
        "kubernetes": { "type": "string", "minLength": 1 }
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "compatibility"],
      "properties": {
        "required": { "type": "boolean" },
        "compatibility": {
          "enum": ["none", "expand-contract", "review-required", "irreversible-approved"]
        },
        "approval_evidence": { "type": "string" }
      }
    },
    "documents": {
      "type": "array",
      "items": { "$ref": "#/$defs/relativePath" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "required"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "required": { "type": "boolean" },
          "mode": {
            "type": "string",
            "pattern": "^[0-7]{3,4}$"
          }
        }
      }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(^|/)\\.\\.?(/|$))(?!.*(^|/)\\.\\.(/|$))[^\\0]+$"
    },
    "relativeExecutable": {
      "$ref": "#/$defs/relativePath"
    },
    "modePayload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "required_files"],
      "properties": {
        "path": { "$ref": "#/$defs/relativePath" },
        "required_files": {
          "type": "array",
          "items": { "$ref": "#/$defs/relativePath" }
        },
        "runtime": { "type": "string" },
        "image_transport": {
          "enum": ["registry", "local-daemon", "archive"]
        },
        "persistence_manifest": {
          "$ref": "#/$defs/relativePath"
        }
      }
    },
    "persistenceCatalogItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_class",
        "default_in_image",
        "required_confirmation",
        "container_path",
        "read_only",
        "override_allowed",
        "backup"
      ],
      "properties": {
        "resource_class": {
          "enum": [
            "frontend",
            "backend",
            "lib",
            "conf",
            "database",
            "object-storage",
            "data",
            "logs",
            "index",
            "extension"
          ]
        },
        "default_in_image": {
          "type": "boolean"
        },
        "required_confirmation": {
          "const": true
        },
        "container_path": {
          "type": "string",
          "pattern": "^/(?![^\\n]*\\.\\.)[^\\n]+$"
        },
        "read_only": {
          "type": "boolean"
        },
        "override_allowed": {
          "type": "boolean"
        },
        "backup": {
          "enum": ["required", "recommended", "not_required"]
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "port": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "port", "protocol", "required"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["tcp", "udp"] },
        "required": { "type": "boolean" }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "common_checks",
        "mode_checks",
        "ports",
        "storage",
        "permissions",
        "resources",
        "dependencies"
      ],
      "properties": {
        "common_checks": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "platform",
              "privilege",
              "directories",
              "ports",
              "storage",
              "permissions",
              "resources",
              "configuration",
              "dependencies",
              "conflict",
              "persistence",
              "lifecycle",
              "security",
              "observability",
              "rollback-space"
            ]
          }
        },
        "mode_checks": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "vm": { "$ref": "#/$defs/checkList" },
            "docker": { "$ref": "#/$defs/checkList" },
            "kubernetes": { "$ref": "#/$defs/checkList" }
          }
        },
        "ports": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/preflightPort" }
        },
        "storage": {
          "$ref": "#/$defs/storageRequirements"
        },
        "permissions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/permissionRequirement" }
        },
        "resources": {
          "$ref": "#/$defs/resourceRequirements"
        },
        "dependencies": {
          "type": "array",
          "items": { "$ref": "#/$defs/dependencyRequirement" }
        }
      }
    },
    "checkList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "runtime",
          "process-identity",
          "docker-daemon",
          "compose",
          "image",
          "mounts",
          "container-identity",
          "kubectl",
          "cluster",
          "namespace",
          "rbac",
          "pvc",
          "service-exposure"
        ]
      }
    },
    "pathRef": {
      "enum": [
        "service_root",
        "conf",
        "data",
        "logs",
        "backup",
        "release_root",
        "docker_root",
        "run",
        "record_root"
      ]
    },
    "storageRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_free_bytes",
        "minimum_free_inodes",
        "safety_margin_percent",
        "paths"
      ],
      "properties": {
        "minimum_free_bytes": { "type": "integer", "minimum": 1 },
        "minimum_free_inodes": { "type": "integer", "minimum": 1 },
        "safety_margin_percent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path_ref", "purpose", "required"],
            "properties": {
              "path_ref": { "$ref": "#/$defs/pathRef" },
              "purpose": { "type": "string", "minLength": 1 },
              "required": { "const": true }
            }
          }
        }
      }
    },
    "permissionRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path_ref", "owner_ref", "group_ref", "mode", "access", "required"],
      "properties": {
        "path_ref": { "$ref": "#/$defs/pathRef" },
        "owner_ref": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$" },
        "group_ref": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$" },
        "mode": { "type": "string", "pattern": "^[0-7]{3,4}$" },
        "access": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["read", "write", "execute"] }
        },
        "required": { "const": true }
      }
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_memory_bytes",
        "minimum_cpu_cores",
        "minimum_open_files",
        "minimum_processes"
      ],
      "properties": {
        "minimum_memory_bytes": { "type": "integer", "minimum": 1 },
        "minimum_cpu_cores": { "type": "integer", "minimum": 1 },
        "minimum_open_files": { "type": "integer", "minimum": 1 },
        "minimum_processes": { "type": "integer", "minimum": 1 }
      }
    },
    "dependencyRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "required"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,63}$" },
        "kind": { "enum": ["database", "cache", "object-storage", "dns", "ntp", "proxy", "registry", "other"] },
        "required": { "type": "boolean" }
      }
    },
    "preflightPort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "port",
        "protocol",
        "required",
        "bind_address",
        "exposure",
        "conflict_policy"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "protocol": { "enum": ["tcp", "udp"] },
        "required": { "type": "boolean" },
        "bind_address": { "type": "string", "minLength": 1 },
        "exposure": { "enum": ["host", "container", "service", "ingress"] },
        "conflict_policy": { "enum": ["must-be-free", "current-service-only", "cluster-allocated"] }
      }
    }
  }
}
