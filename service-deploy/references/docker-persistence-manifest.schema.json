{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.lvdaxianer.local/service-deployment/docker-persistence-manifest.schema.json",
  "title": "Docker Persistence and Override Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service", "service_root", "release_id", "release_root", "runtime_target", "deployment_mode", "mounts", "overrides", "resources"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "service": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "service_root": {"type": "string", "pattern": "^/[^\\n]*$"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"},
    "release_root": {"type": "string", "pattern": "^/[^\\n]*/releases/[^/]+$"},
    "runtime_target": {"const": "docker-container"},
    "deployment_mode": {"const": "docker"},
    "compose_project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["host_path", "container_path", "purpose", "read_only", "backup", "restore_procedure"],
        "properties": {
          "host_path": {"type": "string", "pattern": "^/(?![^\\n]*\\.\\.)[^\\n]+$"},
          "container_path": {"type": "string", "pattern": "^/(?![^\\n]*\\.\\.)[^\\n]+$"},
          "purpose": {"enum": ["config", "secret", "certificate", "data", "database", "index", "override", "logs", "runtime"]},
          "read_only": {"type": "boolean"},
          "backup": {"enum": ["required", "recommended", "not_required"]},
          "restore_procedure": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1},
          "group": {"type": "string", "minLength": 1},
          "mode": {"type": "string", "pattern": "^[0-7]{4}$"}
        },
        "allOf": [
          {
            "not": {
              "properties": {
                "container_path": {"enum": ["/", "/app/lib", "/app/entrypoint.sh", "/var/run/docker.sock"]}
              },
              "required": ["container_path"]
            }
          },
          {
            "if": {
              "properties": {"purpose": {"enum": ["config", "secret", "certificate", "override"]}},
              "required": ["purpose"]
            },
            "then": {"properties": {"read_only": {"const": true}}}
          },
          {
            "if": {
              "properties": {"purpose": {"const": "override"}},
              "required": ["purpose"]
            },
            "then": {"properties": {"host_path": {"pattern": "^/[^\\n]*/releases/[^/]+/overrides/[^\\n]+$"}}}
          }
        ]
      }
    },
    "overrides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_path", "manifest_sha256", "lib", "config"],
      "properties": {
        "manifest_path": {"type": "string", "pattern": "^/[^\\n]*/releases/[^/]+/overrides/[^\\n]+$"},
        "manifest_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
        "lib": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "sha256", "reason"],
            "properties": {
              "path": {"type": "string", "pattern": "^[^/][^\\n]*\\.jar$"},
              "mode": {"enum": ["add", "replace"]},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "reason": {"type": "string", "minLength": 1},
              "compatibility": {"type": "string", "minLength": 1}
            }
          }
        },
        "config": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "mode", "sha256", "reason"],
            "properties": {
              "path": {"type": "string", "pattern": "^[^/][^\\n]*$"},
              "mode": {"enum": ["replace", "merge"]},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "reason": {"type": "string", "minLength": 1},
              "compatibility": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 6,
      "items": {"$ref": "#/$defs/persistenceResource"}
    }
  },
  "$defs": {
    "persistenceResource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource_class",
        "default_in_image",
        "persistence_decision",
        "container_path",
        "read_only",
        "override_allowed",
        "backup",
        "restore_procedure",
        "confirmation"
      ],
      "properties": {
        "resource_class": {
          "enum": [
            "frontend",
            "backend",
            "lib",
            "conf",
            "database",
            "object-storage",
            "data",
            "logs",
            "index",
            "extension"
          ]
        },
        "default_in_image": {"type": "boolean"},
        "persistence_decision": {
          "enum": ["host-persistent", "external-managed"]
        },
        "host_path": {
          "type": "string",
          "pattern": "^/(?![^\\n]*\\.\\.)[^\\n]+$"
        },
        "container_path": {
          "type": "string",
          "pattern": "^/(?![^\\n]*\\.\\.)[^\\n]+$"
        },
        "read_only": {"type": "boolean"},
        "override_allowed": {"type": "boolean"},
        "backup": {
          "enum": ["required", "recommended", "not_required"]
        },
        "restore_procedure": {
          "type": "string",
          "minLength": 1
        },
        "confirmation": {"$ref": "#/$defs/confirmation"},
        "external_owner": {"type": "string", "minLength": 1},
        "endpoint_ref": {"type": "string", "minLength": 1},
        "recovery_evidence": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "not": {
            "properties": {
              "container_path": {
                "enum": ["/", "/app", "/app/bin", "/app/lib", "/app/html", "/app/entrypoint.sh", "/var/run/docker.sock"]
              }
            }
          }
        },
        {
          "not": {
            "properties": {
              "container_path": {
                "pattern": "^/app/(bin|lib|html)(/|$)"
              }
            }
          }
        },
        {
          "if": {
            "properties": {"persistence_decision": {"const": "host-persistent"}},
            "required": ["persistence_decision"]
          },
          "then": {
            "required": ["host_path"]
          }
        },
        {
          "if": {
            "properties": {"persistence_decision": {"const": "external-managed"}},
            "required": ["persistence_decision"]
          },
          "then": {
            "required": ["external_owner", "endpoint_ref", "recovery_evidence"],
            "not": {
              "anyOf": [
                {"required": ["host_path"]},
                {"required": ["pvc"]}
              ]
            }
          }
        },
        {
          "if": {
            "properties": {"override_allowed": {"const": true}},
            "required": ["override_allowed"]
          },
          "then": {
            "properties": {
              "container_path": {"pattern": "^/app/overrides/"}
            }
          }
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmer", "confirmed_at", "record_path"],
      "properties": {
        "status": {"const": "confirmed"},
        "confirmer": {"type": "string", "minLength": 1},
        "confirmed_at": {"type": "string", "format": "date-time"},
        "record_path": {"type": "string", "pattern": "^/[^\\n]+$"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"runtime_target": {"const": "docker-container"}},
        "required": ["runtime_target"]
      },
      "then": {
        "required": ["compose_project"]
      }
    }
  ]
}
