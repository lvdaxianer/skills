{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.lvdaxianer.local/service-deployment/docker-release-manifest.schema.json",
  "title": "Docker Release Unit Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service", "service_root", "release_id", "release_mode", "base_release", "source_commit", "image", "compose_path", "overrides", "override_strategy", "override_chain", "override_compaction", "persistent_paths"],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "service": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "service_root": {"type": "string", "pattern": "^/[^\\n]*$"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"},
    "release_mode": {"enum": ["initial-image", "image-update", "override-only"]},
    "base_release": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"},
    "source_commit": {"type": "string", "pattern": "^(manual|[0-9a-fA-F]{7,64})$"},
    "image": {
      "type": "object", "additionalProperties": false,
      "required": ["reference", "transport", "identity_kind", "identity", "build_mode", "base_release"],
      "properties": {
        "reference": {"type": "string", "pattern": "^(?!.*:latest$)(?!.*:dev$)[A-Za-z0-9._:/@-]+$"},
        "transport": {"enum": ["registry", "local-daemon", "archive"]},
        "identity_kind": {"enum": ["registry-manifest-digest", "local-image-id"]},
        "identity": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
        "build_mode": {"enum": ["built", "reused"]},
        "base_release": {"type": ["string", "null"], "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"},
        "archive_checksum": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "compose_path": {"type": "string", "pattern": "^/[^\\n]*/releases/[^/]+/container/[^\\n]+$"},
    "overrides": {
      "type": "object", "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["path", "sha256", "files"],
        "properties": {
          "path": {"type": "string", "pattern": "^overrides/[^/][^\\n]*$"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "files": {"type": "array", "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "sha256", "mode"],
            "properties": {
              "path": {"type": "string", "pattern": "^overrides/[^/][^\\n]*$"},
              "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
              "mode": {"enum": ["add", "replace", "merge"]},
              "compatibility": {"type": "string", "minLength": 1}
            }
          }}
        }
      }
    },
    "override_strategy": {"enum": ["none", "layered"]},
    "override_chain": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["release_id", "path", "sha256", "precedence"],
        "properties": {
          "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"},
          "path": {"type": "string", "pattern": "^/[^\\n]*/releases/[^/]+/overrides$"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "precedence": {"type": "integer", "minimum": 0}
        }
      }
    },
    "override_compaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "source_release_ids", "source_chain_sha256", "effective_tree_sha256"],
      "properties": {
        "mode": {"enum": ["not_applicable", "baked"]},
        "source_release_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"}},
        "source_chain_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
        "effective_tree_sha256": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"}
      }
    },
    "persistent_paths": {"type": "array", "uniqueItems": true, "items": {"enum": ["conf", "data", "logs", "volumes", "release-records"]}},
    "html_status": {"enum": ["embedded-in-image", "external-release-override", "not_applicable"]}
  },
  "allOf": [
    {
      "if": {"properties": {"release_mode": {"const": "initial-image"}}, "required": ["release_mode"]},
      "then": {"properties": {"base_release": {"const": null}, "override_strategy": {"enum": ["none", "layered"]}, "image": {"properties": {"build_mode": {"const": "built"}, "base_release": {"const": null}}}}}
    },
    {
      "if": {"properties": {"release_mode": {"const": "image-update"}}, "required": ["release_mode"]},
      "then": {"properties": {"image": {"properties": {"build_mode": {"const": "built"}}}}}
    },
    {
      "if": {"properties": {"release_mode": {"const": "override-only"}}, "required": ["release_mode"]},
      "then": {"properties": {"base_release": {"type": "string"}, "override_strategy": {"const": "layered"}, "image": {"properties": {"build_mode": {"const": "reused"}, "base_release": {"type": "string"}}}}}
    },
    {
      "if": {"properties": {"override_compaction": {"properties": {"mode": {"const": "baked"}}}}, "required": ["override_compaction"]},
      "then": {"properties": {"release_mode": {"enum": ["initial-image", "image-update"]}, "override_strategy": {"const": "none"}, "override_chain": {"const": []}, "override_compaction": {"properties": {"source_release_ids": {"minItems": 1}, "source_chain_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "effective_tree_sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}}}}}
    },
    {
      "if": {"properties": {"override_compaction": {"properties": {"mode": {"const": "not_applicable"}}}}, "required": ["override_compaction"]},
      "then": {"properties": {"override_compaction": {"properties": {"source_release_ids": {"maxItems": 0}, "source_chain_sha256": {"type": "null"}, "effective_tree_sha256": {"type": "null"}}}}}
    }
  ]
}
