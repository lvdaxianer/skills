{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.lvdaxianer.local/service-deployment/release-record.schema.json",
  "title": "Service Deployment Release Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service", "service_root", "host", "operator", "timestamp", "timezone", "runtime_target", "container", "lifecycle_mode", "environment_loading", "version_source", "source_commit", "release_id", "release_number", "artifact", "artifact_checksum", "previous_release", "current", "status", "failed_phase", "health_check", "smoke_check", "rollback_target", "rollback_result", "retention", "deleted_releases", "record_path"],
  "properties": {
    "schema_version": {"type": "string", "const": "2"},
    "service": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "service_root": {"type": "string", "pattern": "^/[^\n]*$"},
    "host": {"type": "string", "minLength": 1},
    "operator": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
    "timezone": {"type": "string", "pattern": "^(UTC|[A-Za-z_]+/[A-Za-z_]+|[+-][0-9]{2}:[0-9]{2})$"},
  "runtime_target": {"enum": ["host-process", "docker-container"]},
  "container": {
    "type": ["object", "null"],
    "additionalProperties": false,
    "required": ["repository", "release_tag", "image_transport", "registry", "identity_kind", "image", "digest", "image_identity", "archive_checksum", "latest_alias", "compose_project", "container_id", "release_root", "compose_path", "manifest_path", "persistence_manifest", "override_manifest"],
    "properties": {
      "repository": {"type": "string", "pattern": "^[A-Za-z0-9._:/-]+$"},
      "release_tag": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"},
      "image_transport": {"enum": ["registry", "local-daemon", "archive"]},
      "registry": {"type": ["string", "null"], "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*(/[A-Za-z0-9._-]+)*$"},
      "identity_kind": {"enum": ["registry-manifest-digest", "local-image-id"]},
      "image": {"type": "string", "pattern": "^(?![^@\\n]+:latest$)[^@\\n]+(?::[^@\\n]+|@sha256:[A-Fa-f0-9]{64})$"},
      "digest": {"type": ["string", "null"], "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
      "image_identity": {"type": "string", "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
      "archive_checksum": {"type": ["string", "null"], "pattern": "^[A-Fa-f0-9]{64}$"},
      "latest_alias": {
        "type": "object",
        "additionalProperties": false,
        "required": ["tag", "status", "target_digest", "target_identity", "verified_at", "evidence"],
        "properties": {
          "tag": {"const": "latest"},
          "status": {"enum": ["updated", "not_attempted", "failed", "not_applicable"]},
          "target_digest": {"type": ["string", "null"], "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
          "target_identity": {"type": ["string", "null"], "pattern": "^sha256:[A-Fa-f0-9]{64}$"},
          "verified_at": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$"},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      },
      "compose_project": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,62}$"},
      "container_id": {"type": ["string", "null"], "pattern": "^[a-fA-F0-9]{12,64}$"},
      "release_root": {"type": "string", "pattern": "^/[^\\n]*/releases/[^/]+$"},
      "compose_path": {"type": "string", "pattern": "^/[^\\n]*/releases/[^/]+/container/[^\\n]+$"},
      "manifest_path": {"type": "string", "pattern": "^/[^\\n]*$"},
      "persistence_manifest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "mounts"],
        "properties": {
          "path": {"type": "string", "pattern": "^/[^\\n]*$"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "mounts": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      },
      "override_manifest": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "files"],
        "properties": {
          "path": {"type": "string", "pattern": "^/[^\\n]*$"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
          "files": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["path", "sha256", "mode"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "mode": {"enum": ["add", "replace", "merge"]}}}}
        }
      }
    }
  },
    "lifecycle_mode": {"enum": ["systemd", "manual-foreground", "manual-background"]},
    "environment_loading": {"enum": ["systemd EnvironmentFile", "explicit Shell loader", "dedicated env parser", "not started"]},
    "version_source": {"enum": ["git", "package-version", "manual"]},
    "source_commit": {"type": ["string", "null"], "pattern": "^(manual|[0-9a-fA-F]{7,64})$"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"},
    "release_number": {"type": "string", "pattern": "^[0-9]{3}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "type"], "properties": {"path": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "signature": {"enum": ["verified", "not_configured", "not_required", "failed"]}, "provenance": {"enum": ["verified", "not_configured", "not_required", "failed"]}}},
    "artifact_checksum": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "previous_release": {"type": ["string", "null"]},
    "current": {"type": ["string", "null"]},
    "status": {"enum": ["prepared", "validated", "stopped", "switched", "started", "health-verified", "recorded", "rolled-back", "verified", "failed"]},
    "failed_phase": {"type": ["string", "null"]},
    "health_check": {"type": "object", "additionalProperties": false, "required": ["status", "readiness", "liveness", "dependencies", "loaded_artifact", "evidence"], "properties": {"status": {"enum": ["passed", "failed", "not_applicable"]}, "readiness": {"enum": ["passed", "failed", "not_applicable"]}, "liveness": {"enum": ["passed", "failed", "not_applicable"]}, "dependencies": {"enum": ["passed", "failed", "not_applicable"]}, "loaded_artifact": {"enum": ["passed", "failed", "not_applicable"]}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "smoke_check": {"type": "object", "additionalProperties": false, "required": ["status", "checks", "evidence"], "properties": {"status": {"enum": ["passed", "failed", "not_applicable"]}, "checks": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "rollback_target": {"type": ["string", "null"]},
    "rollback_result": {"enum": ["not_attempted", "passed", "failed", "not_required"]},
    "retention": {"type": "object", "additionalProperties": false, "required": ["keep_count", "preview_path", "apply_status"], "properties": {"keep_count": {"type": "integer", "minimum": 0}, "preview_path": {"type": ["string", "null"]}, "apply_status": {"enum": ["not_run", "previewed", "applied", "blocked"]}}},
    "deleted_releases": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"}},
    "record_path": {"type": "string", "pattern": "^/[^\n]*$"}
  },
  "allOf": [
    {
      "if": {
        "properties": {"runtime_target": {"const": "docker-container"}},
        "required": ["runtime_target"]
      },
      "then": {
        "properties": {"container": {"type": "object"}}
      }
    },
    {
      "if": {
        "properties": {"runtime_target": {"const": "host-process"}},
        "required": ["runtime_target"]
      },
      "then": {
        "properties": {"container": {"type": "null"}}
      }
    },
    {
      "if": {
        "properties": {
          "runtime_target": {"const": "docker-container"},
          "container": {"type": "object", "properties": {"image_transport": {"const": "registry"}}}
        },
        "required": ["runtime_target", "container"]
      },
      "then": {
        "properties": {
          "container": {
            "type": "object",
            "required": ["registry", "digest", "image_identity"],
            "properties": {
              "registry": {"type": "string", "minLength": 1},
              "digest": {"type": "string"},
              "image": {"type": "string", "pattern": "^[^@\\n]+@sha256:[A-Fa-f0-9]{64}$"},
              "identity_kind": {"const": "registry-manifest-digest"},
              "archive_checksum": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_target": {"const": "docker-container"},
          "container": {"type": "object", "properties": {"image_transport": {"enum": ["local-daemon", "archive"]}}}
        },
        "required": ["runtime_target", "container"]
      },
      "then": {
        "properties": {
          "container": {
            "type": "object",
            "required": ["registry", "digest", "image_identity"],
            "properties": {
              "registry": {"type": "null"},
              "digest": {"type": "null"},
              "identity_kind": {"const": "local-image-id"},
              "archive_checksum": {"type": "null"}
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "runtime_target": {"const": "docker-container"},
          "container": {"type": "object", "properties": {"image_transport": {"const": "archive"}}}
        },
        "required": ["runtime_target", "container"]
      },
      "then": {
        "properties": {
          "container": {
            "type": "object",
            "required": ["archive_checksum"],
            "properties": {"archive_checksum": {"type": "string", "minLength": 64, "maxLength": 64}}
          }
        }
      }
    }
  ]
}
