{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://skills.lvdaxianer.local/service-deployment/release-record.schema.json",
  "title": "Service Deployment Release Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "service", "service_root", "host", "operator", "timestamp", "timezone", "lifecycle_mode", "environment_loading", "version_source", "source_commit", "release_id", "release_number", "artifact", "artifact_checksum", "previous_release", "current", "status", "failed_phase", "health_check", "smoke_check", "rollback_target", "rollback_result", "retention", "deleted_releases", "record_path"],
  "properties": {
    "schema_version": {"type": "string", "const": "2"},
    "service": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "service_root": {"type": "string", "pattern": "^/[^\n]*$"},
    "host": {"type": "string", "minLength": 1},
    "operator": {"type": "string", "minLength": 1},
    "timestamp": {"type": "string", "format": "date-time"},
    "timezone": {"type": "string", "pattern": "^(UTC|[A-Za-z_]+/[A-Za-z_]+|[+-][0-9]{2}:[0-9]{2})$"},
    "lifecycle_mode": {"enum": ["systemd", "manual-foreground", "manual-background"]},
    "environment_loading": {"enum": ["systemd EnvironmentFile", "explicit Shell loader", "dedicated env parser", "not started"]},
    "version_source": {"enum": ["git", "package-version", "manual"]},
    "source_commit": {"type": ["string", "null"], "pattern": "^[0-9a-fA-F]{7,64}$"},
    "release_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"},
    "release_number": {"type": "string", "pattern": "^[0-9]{3}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["path", "type"], "properties": {"path": {"type": "string", "minLength": 1}, "type": {"type": "string", "minLength": 1}, "signature": {"enum": ["verified", "not_configured", "not_required", "failed"]}, "provenance": {"enum": ["verified", "not_configured", "not_required", "failed"]}}},
    "artifact_checksum": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"},
    "previous_release": {"type": ["string", "null"]},
    "current": {"type": ["string", "null"]},
    "status": {"enum": ["prepared", "validated", "stopped", "switched", "started", "health-verified", "recorded", "rolled-back", "verified", "failed"]},
    "failed_phase": {"type": ["string", "null"]},
    "health_check": {"type": "object", "additionalProperties": false, "required": ["status", "readiness", "liveness", "dependencies", "loaded_artifact", "evidence"], "properties": {"status": {"enum": ["passed", "failed", "not_applicable"]}, "readiness": {"enum": ["passed", "failed", "not_applicable"]}, "liveness": {"enum": ["passed", "failed", "not_applicable"]}, "dependencies": {"enum": ["passed", "failed", "not_applicable"]}, "loaded_artifact": {"enum": ["passed", "failed", "not_applicable"]}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "smoke_check": {"type": "object", "additionalProperties": false, "required": ["status", "checks", "evidence"], "properties": {"status": {"enum": ["passed", "failed", "not_applicable"]}, "checks": {"type": "array", "items": {"type": "string"}}, "evidence": {"type": "array", "items": {"type": "string"}}}},
    "rollback_target": {"type": ["string", "null"]},
    "rollback_result": {"enum": ["not_attempted", "passed", "failed", "not_required"]},
    "retention": {"type": "object", "additionalProperties": false, "required": ["keep_count", "preview_path", "apply_status"], "properties": {"keep_count": {"type": "integer", "minimum": 0}, "preview_path": {"type": ["string", "null"]}, "apply_status": {"enum": ["not_run", "previewed", "applied", "blocked"]}}},
    "deleted_releases": {"type": "array", "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}-[0-9]{14}-[A-Za-z0-9][A-Za-z0-9._+~-]{0,63}-[0-9]{3}$"}},
    "record_path": {"type": "string", "pattern": "^/[^\n]*$"}
  }
}
